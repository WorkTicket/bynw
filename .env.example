# Copy to .env.local for local dev and set the same values as
# Cloudflare Workers secrets / wrangler.toml [vars] for production.

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Search Console — optional meta verification token (NOT the .html filename).
# Prefer the HTML file already at /public/googleb0de3a7eb0c354a5.html, or DNS verification.
# Only set this if GSC gives you a meta tag content= token.
NEXT_PUBLIC_GSC_VERIFICATION=

# Optional public legal address shown on privacy/terms (recommended for EU ads).
# Example: "Calle Ejemplo 1, Ciudad, País"
NEXT_PUBLIC_LEGAL_ADDRESS=

# Google Analytics — measurement ID (format: G-XXXXXXXXXX)
# Production is set in wrangler.toml [vars].
# Loads ONLY after cookie consent (analytics).
NEXT_PUBLIC_GA_ID=

# Meta / Facebook Pixel — pixel ID (format: 000000000000000)
# Loads ONLY after cookie consent (marketing).
# Events: PageView, ViewContent, InitiateCheckout, Lead, Contact, Purchase
# (Purchase: Hotmart Pixel + CAPI webhook + optional /gracias browser fire).
#
# === META ADS + PIXEL OPS CHECKLIST (do before scaling spend) ===
# 1. wrangler secret put MAILCHIMP_API_KEY
# 2. wrangler secret put MAILCHIMP_AUDIENCE_ID
# 3. wrangler secret put META_CAPI_ACCESS_TOKEN
#    (Events Manager → Settings → Generate access token)
# 4. wrangler secret put HOTMART_HOTTOK
#    (Hotmart → Tools → Webhook → same token sent as X-Hotmart-Hottok / hottok)
# 5. Hotmart webhook URL:
#    https://bynmwcreative.com/api/webhooks/hotmart
#    Events: PURCHASE_APPROVED (and PURCHASE_COMPLETE if available)
# 6. Hotmart → Integrations → Facebook Pixel:
#    - SAME Pixel ID as NEXT_PUBLIC_FB_PIXEL_ID
#    - Enable Purchase with value + currency (EUR)
# 7. Hotmart thank-you redirect →:
#    https://bynmwcreative.com/gracias?transaction={{transaction}}&value={{price}}&currency=EUR
#    (Variables depend on Hotmart plan; at minimum redirect to /gracias)
# 8. Cold Facebook/Instagram ads may land on HOME (catalog) or a product lander:
#    Home (her preferred): https://bynmwcreative.com/?utm_source=facebook&utm_medium=paid&utm_campaign=es_home_cold&utm_content=v1
#    Product lander (higher convert): https://bynmwcreative.com/ads/princesas-disney?utm_source=facebook&utm_medium=paid&utm_campaign=es_princesas_cuento_cold&utm_content=v1
#    Always include utm_source + utm_medium=paid so pixel/consent/sticky buy run in paid mode.
#    Match utm_campaign keywords to a product (princesas, flores, chenille…) so sticky CTA maps correctly.
# 9. npm run deploy
# 10. Smoke-test Meta Events Manager → Probar eventos on /?utm_source=facebook&utm_medium=paid:
#     Accept cookies → PageView → sticky Comprar → InitiateCheckout (site)
#     + Purchase (Hotmart pixel and/or CAPI, same event_id = transaction)
# 11. Optional while testing CAPI: wrangler secret put META_CAPI_TEST_EVENT_CODE
# 12. Max CPA target for Princesas 15€ ≈ 10€ (sano 6–9€). Do not scale above that.
# 13. Creative tests: vary utm_content (v1, v2, …); one product + one destination per ad set
NEXT_PUBLIC_FB_PIXEL_ID=

# Meta CAPI (server) — NEVER expose in NEXT_PUBLIC_*
META_CAPI_ACCESS_TOKEN=
# Optional override; defaults to NEXT_PUBLIC_FB_PIXEL_ID
META_PIXEL_ID=
# Optional test code from Events Manager → Test Events
META_CAPI_TEST_EVENT_CODE=

# Hotmart webhook verification token (must match Hotmart webhook config)
HOTMART_HOTTOK=

# Mailchimp — saves name/email from the free gift form
# Without these secrets, the PDF still downloads but leads are NOT saved.
MAILCHIMP_API_KEY=
MAILCHIMP_AUDIENCE_ID=

# Reviews are stored in Cloudflare KV (binding REVIEWS in wrangler.toml).
# Local `next dev` falls back to .data/reviews.json (+ .data/review-images/).
