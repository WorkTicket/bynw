# Copy to .env.local for local dev and set the same values as
# Cloudflare Workers secrets / wrangler.toml [vars] for production.

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Search Console — optional meta verification token (NOT the .html filename).
# Prefer the HTML file already at /public/googleb0de3a7eb0c354a5.html, or DNS verification.
# Only set this if GSC gives you a meta tag content= token.
NEXT_PUBLIC_GSC_VERIFICATION=

# Google Analytics — measurement ID (format: G-XXXXXXXXXX)
# Production is set in wrangler.toml [vars].
NEXT_PUBLIC_GA_ID=

# Meta / Facebook Pixel — pixel ID (format: 000000000000000)
# Required for Facebook Ads: fires PageView, ViewContent (PDP + /ads landers),
# InitiateCheckout (buy click), Lead (gift form), Contact (WhatsApp).
# UTM/fbclid are persisted in session and appended to Hotmart checkout URLs.
#
# === META ADS + PIXEL OPS CHECKLIST (do before scaling spend) ===
# 1. wrangler secret put MAILCHIMP_API_KEY
# 2. wrangler secret put MAILCHIMP_AUDIENCE_ID
# 3. Hotmart → Integrations → Facebook Pixel:
#    - Use the SAME Pixel ID as NEXT_PUBLIC_FB_PIXEL_ID (site + Hotmart = one pixel)
#    - Enable Purchase with value + currency (EUR offer + MX offer)
#    - Confirm Events Manager shows Purchase after a test checkout (not only InitiateCheckout)
# 4. Point EVERY cold Facebook/Instagram ad to a PRODUCT lander — never / or /shop:
#    https://bynmwcreative.com/ads/princesas-disney?utm_source=facebook&utm_medium=paid&utm_campaign=es_princesas_disney_cold&utm_content=v1
#    Match slug to creative (flores-eternas, amigurumis-chenille, …).
#    /ads catalog is warm/retargeting only. Middleware also redirects paid UTM/fbclid
#    hits on / and /shop* → /ads/{slug} as a safety net (still fix Ads Manager URLs).
# 5. Hotmart thank-you / post-purchase redirect (or email CTA) →:
#    https://bynmwcreative.com/gracias
#    (WhatsApp support + photo review ask — retention loop)
# 6. npm run deploy
# 7. Smoke-test Meta Events Manager → Probar eventos on /ads/princesas-disney:
#    PageView → ViewContent → InitiateCheckout (site) + Purchase (Hotmart pixel, EUR)
# 8. If Purchase is missing/undercounted (iOS / ad blockers): add Hotmart webhook → Meta CAPI
# 9. Max CPA target for Princesas 15€ ≈ 10€ (sano 6–9€). Do not scale above that.
# 10. Creative tests: vary utm_content (v1, v2, …); keep one product + one destination per ad set
#     until Purchase is clean in Events Manager.
NEXT_PUBLIC_FB_PIXEL_ID=

# Mailchimp — saves name/email from the free gift form
# Without these secrets, the PDF still downloads but leads are NOT saved.
MAILCHIMP_API_KEY=
MAILCHIMP_AUDIENCE_ID=

# Reviews are stored in Cloudflare KV (binding REVIEWS in wrangler.toml).
# Local `next dev` falls back to .data/reviews.json (+ .data/review-images/).
